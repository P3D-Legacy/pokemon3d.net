APP_NAME="Pokémon 3D"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
PHP_CLI_SERVER_WORKERS=4

INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pokemon3d
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=s3
# Library skins use this Cloud object-storage disk (scoped prefix: skin/).
# Must match the Laravel Cloud object storage "disk name". Cloud injects
# LARAVEL_CLOUD_DISK_CONFIG and overrides that disk. Player skins stay local
# in public/player/{gamejoltId}.png (gitignored except .gitignore).
SKINS_OBJECT_DISK=s3
AWS_BUCKET=
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT=
AWS_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SKIN_MAX_UPLOAD=10
LOGIN_AUTH_BLOG_POST=
LANG_CONTRIBUTION_URL=
GAME_SERVER_URL="https://karp.pokemon3d.net"
WIKI_BASE_URL="https://wiki.pokemon3d.net"

SUPER_ADMIN_EMAIL=
MAIL_TO_ADDRESS="${SUPER_ADMIN_EMAIL}"

GAMEJOLT_GAME_ID=
GAMEJOLT_GAME_PRIVATE_KEY=
GAMEJOLT_USER_ID_SUPERADMIN=

GITHUB_API_REPO=https://api.github.com/repos/P3D-Legacy/P3D-Legacy

DISCORD_SKIN_UPLOAD_WEBHOOK=
DISCORD_GAME_SAVE_FIX_WEBHOOK=
DISCORD_TOKEN=
DISCORD_SERVER_ID=
DISCORD_INVITE_URL="https://discordapp.com/invite/EUhwdrq"
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

XENFORO_BASE_WEB_URL="https://forum.pokemon3d.net"
XENFORO_API_KEY=

SCRIBE_AUTH_KEY=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Production: set MAIL_MAILER=lettermint
LETTERMINT_PROJECT_TOKEN=
LETTERMINT_ROUTE_ID=
LETTERMINT_TEAM_TOKEN=

IPGEOLOCATION_KEY=

PLAUSIBLE_API_KEY=

TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=
TUMBLR_OAUTH_TOKEN=
TUMBLR_OAUTH_TOKEN_SECRET=

# SpamMailChecker driver: "local" (package domain list), "remote" (DNS/MX checks), or an API driver.
# "remote" complements propaganistas/laravel-disposable-email by rejecting non-existent domains.
SPAM_MAIL_CHECKER_DEFAULT_DRIVER=local

SHADCNBLOCKS_API_KEY=
